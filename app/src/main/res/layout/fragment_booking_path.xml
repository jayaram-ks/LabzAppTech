<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingHorizontal="8dp"
    android:paddingVertical="5dp"
    android:background="@color/white">
    <com.google.android.material.card.MaterialCardView
        android:layout_height="wrap_content"
        android:layout_width="match_parent"
        app:cardCornerRadius="10dp"
        app:strokeColor="@color/green_border"
        app:strokeWidth="1dp"
        app:cardBackgroundColor="@color/white"
        android:layout_marginVertical="4dp">

        <LinearLayout android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                android:background="@color/reddishdark"
                android:paddingVertical="4dp"
                android:paddingHorizontal="10dp"
                android:textStyle="bold"
                android:text="Finish Location - Laboratory Location"
                android:textSize="14sp"

                android:shadowColor = "@color/txtShadow"
                android:shadowDx="2"
                android:shadowDy="2"
                android:shadowRadius="2"
                />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="5dp" >

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingHorizontal="5dp"
                    >

                    <TextView
                        android:id="@+id/lab_title"
                        android:gravity="top"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/lato_bold"
                        android:maxLines="2"
                        android:letterSpacing=".01"
                        android:textColor="@color/black"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/lab_details"
                        android:gravity="top"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/lato_regular"
                        android:letterSpacing=".01"
                        android:textColor="@color/black"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/pin_code"
                        android:gravity="top"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:letterSpacing=".01"
                        android:textColor="@color/black"
                        android:textSize="12sp" />


                    <TextView
                        android:id="@+id/lab_lat"
                        android:gravity="top"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/black"
                        android:letterSpacing=".01"
                        android:fontFamily="@font/lato_regular"
                        android:textSize="12sp"
                        />
                    <TextView
                        android:id="@+id/lab_long"
                        android:gravity="top"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/black"
                        android:letterSpacing=".01"
                        android:fontFamily="@font/lato_regular"
                        android:textSize="12sp"
                        android:paddingBottom="2dp"
                        />

                </LinearLayout>

            </LinearLayout>


        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal">
        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/up_arrow"/>
        <TextView android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:textSize="20dp"
            android:id="@+id/distance_text"
            android:gravity="center_vertical"
            android:textStyle="bold"
            android:text="Calculating distance..."/>
        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/down_arrow"/>
        </LinearLayout>

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="10dp"
        app:cardElevation="15dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                android:background="@color/reddishdark"
                android:paddingVertical="4dp"
                android:paddingHorizontal="10dp"
                android:textStyle="bold"
                android:textSize="14sp"
                android:text="Start Location - Sample collection location"
                android:shadowColor = "@color/txtShadow"
                android:shadowDx="2"
                android:shadowDy="2"
                android:shadowRadius="2"
                />
            <RelativeLayout android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_gravity="center_horizontal">
                <fragment
                    android:id="@+id/map_labdet"
                    class="com.google.android.gms.maps.SupportMapFragment"
                    android:layout_width="match_parent"
                    android:layout_height="230dp"/>
                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_centerHorizontal="true"
                    android:layout_centerVertical="true"
                    android:src="@drawable/ic_google_maps"
                    />

                <LinearLayout android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="3dp"
                    android:orientation="horizontal">
                    <TextView
                        android:id="@+id/usr_lat"
                        android:paddingEnd="5dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/white"
                        android:shadowColor="@color/black"
                        android:shadowRadius="5"
                        android:shadowDx="0"
                        android:shadowDy="0"
                        android:fontFamily="@font/roboto_condensed_regular"
                        android:textSize="9sp"
                        />
                    <TextView
                        android:id="@+id/usr_long"
                        android:paddingEnd="5dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/white"
                        android:shadowColor="@color/black"
                        android:shadowRadius="5"
                        android:shadowDx="0"
                        android:shadowDy="0"
                        android:fontFamily="@font/roboto_condensed_regular"
                        android:textSize="9sp"
                        />
                </LinearLayout>
            </RelativeLayout>
            <TextView
                android:id="@+id/location_address"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                android:background="@color/reddishdark"
                android:paddingVertical="4dp"
                android:paddingHorizontal="10dp"
                android:textSize="12sp"
                android:fontFamily="@font/roboto_condensed_regular"
                />
        </LinearLayout>

    </androidx.cardview.widget.CardView>

    <Button
        android:id="@+id/pathsave_btn"
        android:layout_width="wrap_content"
        android:layout_height="45dp"
        android:text="Sample Collected from Above location"
        android:layout_gravity="center_horizontal"
        android:textAllCaps="false"
        android:layout_marginTop="10dp"
        android:layout_marginStart="15dp"
        android:layout_marginEnd="15dp"
        android:background="@drawable/round_button_white"
        app:backgroundTint="@color/orange"
        android:layout_marginBottom="15dp"
        android:letterSpacing=".01"
        android:textSize="14sp"/>

</LinearLayout>